        <mxCell id="v0RbmGngDZIMgWs67sPv-5" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;CCTV, VDS, 검지기 등 다양한 센서 통한&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;차량&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;통행량, 속도, 점유율 등 수집&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;AI 기반 객체 탐지로 돌발 상황&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;(사고, 정체, 고장차량 등) 자동 감지&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;수집된 원시 데이터 정제 및 가공&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 150%;&quot;&gt;시간,구간별 통계 산출&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="v0RbmGngDZIMgWs67sPv-4">
