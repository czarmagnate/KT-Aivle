        <mxCell id="MTCsaoP7Ni1JglXyqCcd-2" value="미디어 서버" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="MTCsaoP7Ni1JglXyqCcd-0">
          <mxGeometry x="1" y="55" width="69" height="30" as="geometry" />
