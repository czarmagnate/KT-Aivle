        <mxCell id="VHRvl10N6HVd7566nv8x-83" value="&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 이메일/SNS 회원가입&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 아이디/비밀번호 찾기&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● OAuth2 기반 소셜 로그인&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 자동 로그인, 로그인 유지&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 개인정보 수정(이름, 이메일, 연락처 등)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 비밀번호 변경&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 배송지 추가/삭제/기본 설정&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 회원 탈퇴&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 구매금액 기준 회원 등급 자동 산정&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 등급별 혜택(할인, 쿠폰 등)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 포인트 적립 및 사용 내역&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 생일/이벤트 포인트 지급&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 약관 동의 관리(이용약관 등)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 마케팅 활용을 위한 고객 데이터 조회&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="VHRvl10N6HVd7566nv8x-77" vertex="1">
          <mxGeometry x="4.545934530095036" y="28.07602335189975" width="228.30693417810627" height="208" as="geometry" />
