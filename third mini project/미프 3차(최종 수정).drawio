        <mxCell id="VHRvl10N6HVd7566nv8x-79" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;● 상품 목록 조회, 필터 / 정렬 기능&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;● 상품 카테고리 별 탐색 기능&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;● 상품 상세 이미지 및 설명 기능&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;● 상품 구매 후기 / 별점 보기 기능&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;● 상품 재고 표시 및 품절 처리 기능&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 검색 최적화 시스템(별도 검색 인덱스 DB를 관리)&lt;/span&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&amp;nbsp; &amp;nbsp;- 키워드 검색&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&amp;nbsp; &amp;nbsp;- 자동완성 / 검색어 추천&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&amp;nbsp; &amp;nbsp;- 인기 상품 / 신상품 모음&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● AI추천 시스템&lt;br&gt;(최근 본 상품, 유사 관심 상품을 분석해 사용자 취향 기반의 상품 추천 기능 강화)&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="VHRvl10N6HVd7566nv8x-44" vertex="1">
          <mxGeometry x="5.701404435058123" y="28.080000000000013" width="226" height="208" as="geometry" />
        </mxCell>
        <mxCell id="VHRvl10N6HVd7566nv8x-77" value="회원 및 계정관리 시스템" style="swimlane;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="VHRvl10N6HVd7566nv8x-33" vertex="1">
          <mxGeometry x="493.99155227032725" y="32.07000000000001" width="237.39880323829632" height="245.59" as="geometry" />
