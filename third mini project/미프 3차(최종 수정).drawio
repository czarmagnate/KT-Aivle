        <mxCell id="VHRvl10N6HVd7566nv8x-82" value="&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 할인 이벤트 등록&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 기간별 쿠폰 발행/적용&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 기획전 상품 배너 설정&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 메인/카테고리 배너 운영&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 광고주 상품/브랜드 노출 설정&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 외부 링크 삽입&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 텍스트/이미지 리뷰 작성&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 별점 평가 등록&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 베스트 리뷰 선정/노출&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 신고/필터링 처리 기능 포함&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="VHRvl10N6HVd7566nv8x-75" vertex="1">
