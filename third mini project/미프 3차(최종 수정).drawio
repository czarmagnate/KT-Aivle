        <mxCell id="VHRvl10N6HVd7566nv8x-81" value="&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 상품 추가 / 삭제 / 수량 변경&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 선택 상품 주문&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 쿠폰 / 적립금 적용&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 예상 결제 금액 계산&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 결제 수단 선택(카드, 계좌이체, 간편결제 등)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 결제 인증 / 승인 [PG사(결제대행사) 연동]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 결제 실패 시 재시도 처리&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 쿠폰 및 포인트 적용 로직&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 주문 내역 조회&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 배송 조회(송장번호 기반)&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 주문 취소, 반품 신청&lt;/span&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 10px; text-align: center;&quot;&gt;● 반품 / 교환 요청 상태 확인&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="VHRvl10N6HVd7566nv8x-74" vertex="1">
          <mxGeometry x="6.576451953537476" y="26.37602335189976" width="228.30693417810627" height="208" as="geometry" />
